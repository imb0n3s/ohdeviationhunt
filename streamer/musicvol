#!/usr/bin/env bash
# docker exec dh-stream musicvol 60   — music volume on the 24/7 stream (0-100, 0 = off; the spawn alert isn't affected)
v="${1:-}"
if ! [[ "$v" =~ ^[0-9]+$ ]] || [ "$v" -gt 100 ]; then
  echo "Music volume: $(cat /music/.volume 2>/dev/null || echo 60)   ($(find /music -type f \( -iname '*.mp3' -o -iname '*.flac' -o -iname '*.ogg' -o -iname '*.opus' -o -iname '*.m4a' -o -iname '*.wav' \) | wc -l) songs)"
  echo "Usage: musicvol <0-100>"; exit 0
fi
echo "$v" > /music/.volume && pkill -x mpv; echo "Music volume set to $v."
