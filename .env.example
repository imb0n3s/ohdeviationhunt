# ---- Twitch developer app (dev.twitch.tv/console/apps) — its OWN app, not the wiki bot's ----
# OAuth Redirect URL in the app must be <BASE_URL>/auth/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
BASE_URL=https://your-service.up.railway.app

# Secrets you make up (long random strings). ADMIN_KEY unlocks /setup and /admin.
ADMIN_KEY=
SESSION_SECRET=

# SQLite lives here. On Railway, mount a volume at /data.
DATA_DIR=/data

# ---- Optional ----
# BOT_NAME=Deviation Hunt
# WIKI_BASE=https://ohwikiguide.com
# DEVIATION_PAGE=Deviation_Main_Page
# SPAWN_INTERVAL_MIN=10        default minutes between breaches (mods can change per channel)
# SPAWN_WINDOW_SECONDS=90      how long a deviation stays catchable
# ACTIVITY_WINDOW_MIN=10       someone must have chatted this recently for a spawn
# LIVE_POLL_SECONDS=120
# SPAWN_OFFLINE=1              testing only: spawn even when the channel is offline
